import streamlit as st
import pandas as pd
from datetime import datetime
import plotly.graph_objects as go
from plotly.subplots import make_subplots

from utils.data_processor import process_financial_data
from utils.ratios import calculate_all_ratios
from utils.report_generator import generate_pdf_report

st.set_page_config(page_title="Financial Repair • Turnaround OS", layout="wide", page_icon="🔧")
st.title("🔧 Financial Repair OS")
st.markdown("**Production-Grade Turnaround Management Platform**")

# Sidebar
st.sidebar.header("Upload Financial Data")
uploaded_file = st.sidebar.file_uploader("Upload Excel/CSV (3 Statements)", type=["xlsx", "csv"])

if uploaded_file:
    try:
        df_income, df_bs, df_cf = process_financial_data(uploaded_file)
        st.sidebar.success("✅ Data Loaded Successfully")
    except Exception as e:
        st.sidebar.error(f"Error loading file: {e}")
        st.stop()
else:
    st.info("Please upload your financial data (Excel/CSV) to begin analysis.")
    st.stop()

# ====================== MAIN DASHBOARD ======================
tab1, tab2, tab3, tab4, tab5 = st.tabs([
    "📊 Overview", "📋 Statement Analysis", "📈 Ratios & Benchmarks", 
    "🔍 Problem Diagnosis", "💡 Repair Plan & Scenarios"
])

with tab1:
    col1, col2, col3, col4 = st.columns(4)
    with col1:
        st.metric("Latest Revenue", f"£{df_income['Revenue'].iloc[-1]:,}")
    with col2:
        st.metric("Net Income", f"£{df_income['Net_Income'].iloc[-1]:,}", 
                 delta=f"£{df_income['Net_Income'].diff().iloc[-1]:,}")
    with col3:
        st.metric("Cash Balance", f"£{df_bs['Cash'].iloc[-1]:,}")
    with col4:
        st.metric("Debt/Equity", f"{(df_bs['Total_Debt'].iloc[-1] / df_bs['Equity'].iloc[-1]):.2f}")

    # Trends
    fig = make_subplots(rows=1, cols=3, subplot_titles=("Revenue vs Profit", "Cash Trend", "Leverage Trend"))
    fig.add_trace(go.Bar(x=df_income['Year'], y=df_income['Revenue'], name="Revenue", marker_color='#00ff9d'), row=1, col=1)
    fig.add_trace(go.Bar(x=df_income['Year'], y=df_income['Net_Income'], name="Net Income", marker_color='#ff4d4d'), row=1, col=1)
    fig.add_trace(go.Scatter(x=df_bs['Year'], y=df_bs['Cash'], name="Cash", line=dict(color='gold', width=4)), row=1, col=2)
    fig.add_trace(go.Scatter(x=df_bs['Year'], y=df_bs['Total_Debt'], name="Total Debt", line=dict(color='red')), row=1, col=3)
    fig.update_layout(height=450, template="plotly_dark")
    st.plotly_chart(fig, use_container_width=True)

with tab2:
    st.subheader("Financial Statements")
    col_a, col_b = st.columns(2)
    with col_a:
        st.dataframe(df_income.style.format("£{:,.0f}"), use_container_width=True)
    with col_b:
        st.dataframe(df_bs.style.format("£{:,.0f}"), use_container_width=True)
    st.dataframe(df_cf.style.format("£{:,.0f}"), use_container_width=True)

with tab3:
    st.subheader("Key Financial Ratios & Health Score")
    ratios = calculate_all_ratios(df_income, df_bs, df_cf)
    
    col1, col2 = st.columns(2)
    with col1:
        for key, value in list(ratios.items())[:6]:
            st.metric(key.replace("_", " "), value)
    with col2:
        for key, value in list(ratios.items())[6:]:
            st.metric(key.replace("_", " "), value)

with tab4:
    st.subheader("🔴 Diagnosis Engine")
    diagnosis = []
    
    if ratios['Current_Ratio'] < 1.2:
        diagnosis.append("🚨 Severe Liquidity Risk")
    if ratios['Net_Profit_Margin'] < 0:
        diagnosis.append("🚨 Company is Loss Making")
    if ratios['Operating_Cash_Flow'] < 0:
        diagnosis.append("🚨 Negative Operating Cash Flow")
    if ratios['Debt_to_Equity'] > 2.0:
        diagnosis.append("🚨 Dangerous Leverage")
    if df_income['Operating_Expenses'].pct_change().mean() > 0.15:
        diagnosis.append("⚠️ Operating costs growing too fast")

    for issue in diagnosis:
        st.error(issue)

    st.info(f"**Overall Financial Health Score: {ratios['Health_Score']}/100**")

with tab5:
    st.subheader("💡 Turnaround Recommendations & Scenario Modeling")
    
    st.markdown("### Priority Turnaround Actions")
    st.markdown("""
    1. **Emergency Cash Control** — Cut non-essential OPEX by 20-30%
    2. **Working Capital Release** — Reduce DSO by 15 days + lower inventory
    3. **Pricing & Margin Recovery** — Selective price increases + product rationalization
    4. **Debt Optimization** — Refinance expensive debt
    5. **Revenue Acceleration** — Focus on high-margin customers and new recurring streams
    """)

    # Scenario Modeling
    st.subheader("What-If Scenario Modeling")
    cost_cut = st.slider("Cost Reduction (%)", 0, 40, 20)
    price_increase = st.slider("Price Increase (%)", 0, 25, 8)
    revenue_growth = st.slider("Additional Revenue Growth (%)", 0, 30, 12)

    # Simulate
    latest = df_income.iloc[-1].copy()
    new_revenue = latest['Revenue'] * (1 + revenue_growth/100)
    new_cogs = latest['COGS'] * 0.95
    new_opex = latest['Operating_Expenses'] * (1 - cost_cut/100)
    new_ebit = new_revenue - new_cogs - new_opex
    new_net = new_ebit * 0.75  # simplified tax/interest

    st.success(f"""
    **Projected 2026 Outcome with Actions**:
    - Revenue: £{new_revenue:,.0f}
    - Net Income: £{new_net:,.0f}
    - Improvement: **{((new_net - latest['Net_Income'])/abs(latest['Net_Income'])*100 if latest['Net_Income'] != 0 else 100):.1f}%**
    """)

    if st.button("Generate Full Turnaround Report (PDF)"):
        pdf_path = generate_pdf_report(df_income, df_bs, df_cf, ratios, new_net)
        with open(pdf_path, "rb") as f:
            st.download_button("Download PDF Report", f, file_name=f"Turnaround_Report_{datetime.now().strftime('%Y%m%d')}.pdf")

st.caption("Production-Grade Financial Turnaround Platform • Built for Executive Decision Making")
